# .env.example — Sovranly IP Command Center
# Copy this file to .env.local and fill in your values.

# ─── Firebase (Client) ───
# Found in Firebase Console → Project Settings → Your Apps → Web App
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: specify a named Firestore database ID (leave empty for default)
NEXT_PUBLIC_FIREBASE_DATABASE_ID=

# ─── Gemini AI ───
# Found in Google AI Studio → API Key
GEMINI_API_KEY=
# Optional: override the model name (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ─── App Configuration & Domains ───
NEXT_PUBLIC_SITE_URL=https://www.sovranlyip.com
NEXT_PUBLIC_APP_URL=https://app.sovranlyip.com
# Optional: Google Search Console verification code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Server-side Firebase Admin (for token verification) ───
# In production, set GOOGLE_APPLICATION_CREDENTIALS to the path of your
# service account JSON, or use Workload Identity Federation on Cloud Run.

# ─── Stripe (Payments & Checkout Links) ───
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_LINK_LITE=https://buy.stripe.com/4gM5kxdTrgPq1r4bOFf3a01
NEXT_PUBLIC_STRIPE_LINK_PRO=https://buy.stripe.com/cNi5kx3eN6aM1r46ulf3a02
NEXT_PUBLIC_STRIPE_LINK_STUDIO=https://buy.stripe.com/7sYeV76qZ2YA2v82e5f3a03
